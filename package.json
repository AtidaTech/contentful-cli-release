{
  "name": "contentful-cli-release",
  "version": "2.0.0",
  "type": "module",
  "description": "Contentful CLI Release tool",
  "homepage": "https://github.com/AtidaTech/contentful-cli-release",
  "keywords": [
    "contentful",
    "management",
    "release",
    "cli-release",
    "contentful-release",
    "branch",
    "branching",
    "cli",
    "git",
    "github",
    "gitlab",
    "ci/cd"
  ],
  "bin": {
    "contentful-cli-release": "./contentful-cli-release.js"
  },
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=12.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AtidaTech/contentful-cli-release.git"
  },
  "author": "Atida <hello@atida.com>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint contentful-cli-release.js test scripts eslint.config.js",
    "lint-fix": "eslint contentful-cli-release.js test scripts eslint.config.js --fix",
    "format:check": "prettier --check contentful-cli-release.js test scripts eslint.config.js",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm test && node scripts/check-package.js",
    "prepublishOnly": "npm run check && npm audit --audit-level=low && node scripts/check-package.js --release"
  },
  "dependencies": {
    "contentful-lib-helpers": "^2.0.0",
    "contentful-management": "^12.20.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "follow-redirects": "^1.16.2",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "packageManager": "npm@12.2.1",
  "files": [
    "contentful-cli-release.js",
    "CHANGELOG.md"
  ]
}
